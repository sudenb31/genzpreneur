{
  "functions": {
    "api/goakal/webhook.js": {
      "maxDuration": 30
    },
    "api/goakal/sync.js": {
      "maxDuration": 60
    },
    "api/trial/start.js": {
      "maxDuration": 30
    },
    "api/cron/trial-reminder.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trial-reminder",
      "schedule": "0 1 * * *"
    }
  ]
}
